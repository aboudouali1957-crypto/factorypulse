# Copie ce fichier en ".env" sur le serveur, puis remplis les valeurs.
# Le fichier .env ne doit JAMAIS être commité (il est dans .gitignore).

# Domaine public. Sans nom de domaine, sslip.io en fournit un gratuit à partir de l'IP du serveur :
# IP 13.38.1.25  →  13-38-1-25.sslip.io
FP_DOMAIN=13-38-1-25.sslip.io

# Mot de passe de la console d'administration Keycloak (https://<domaine>/auth). Choisis-en un long.
KC_ADMIN_PASSWORD=change-moi
